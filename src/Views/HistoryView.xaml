<UserControl x:Class="TeamWpfCalc.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="150" Width="200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <ListBox x:Name="HistoryList" Grid.Row="0" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        <Button Grid.Row="1" Content="⌫ Удалить последнее" Height="30" Margin="5"/>
    </Grid>
</UserControl>